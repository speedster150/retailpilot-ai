# ==============================================================================
# RetailPilot AI — Environment Variable Reference & Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (Vercel, AWS, Azure, GCP, Docker), set these via platform secrets.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# The project URL for your Supabase PostgreSQL instance.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# The client-safe Supabase publishable/anon key.
# Used by both browser (@supabase/ssr createBrowserClient) and server (@supabase/ssr createServerClient)
# with signed cookie sessions enforcing Row Level Security (RLS) and multi-tenancy.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

# Optional: Supabase service role key (SERVER ONLY - NEVER expose with NEXT_PUBLIC_ prefix).
# Not required for normal application runtime since all operations use user cookie sessions.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here

# ------------------------------------------------------------------------------
# 2. MAKE.COM WEBHOOK INTEGRATIONS (OPTIONAL / ENTERPRISE AUTOMATIONS)
# ------------------------------------------------------------------------------
# Primary Make.com webhook URL for automated low-stock notifications:
MAKE_LOW_STOCK_WEBHOOK_URL=https://hook.eu1.make.com/your_webhook_id_here

# Dedicated webhook for dead stock audit alerts:
# MAKE_DEAD_STOCK_WEBHOOK_URL=https://hook.eu1.make.com/your_dead_stock_webhook

# Dedicated webhook for supplier overdue payment escalation alerts:
# MAKE_SUPPLIER_ESCALATION_WEBHOOK_URL=https://hook.eu1.make.com/your_escalation_webhook

# Dedicated webhook for end-of-day sales dossier dispatches:
# MAKE_DAILY_DOSSIER_WEBHOOK_URL=https://hook.eu1.make.com/your_dossier_webhook

# Dedicated webhook for monthly executive financial report dispatches:
# MAKE_MONTHLY_REPORT_WEBHOOK_URL=https://hook.eu1.make.com/your_monthly_report_webhook

# Fallback generic webhook for all automation scenarios:
# MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_generic_webhook

# ------------------------------------------------------------------------------
# 3. REGIONAL & BUSINESS LOCALIZATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Default business timezone for timestamp formatting in automation dossiers (Default: UTC or Asia/Kolkata)
# BUSINESS_TIMEZONE=Asia/Kolkata
